#!/bin/sh
set -eu
cd /home/cxr/agent-harness-mt
BUN=/usr/local/bin/bun
DB=/data/harness/live-full-flow/harness.sqlite
BACKUP_DIR=/data/harness/backups
VM_RUNTIME=/data/harness/live-full-flow/vm-runtime
SNAPSHOT_POOL=/data/harness/snapshots-mt
ARTIFACT_ROOT=/data/harness/live-full-flow/artifacts
BROKER_ENV=${HARNESS_BROKER_ENV_FILE:-/etc/harness/broker.env}

# 快照池清理会豁免当前模板快照：templateHash = sha256(kernel + rootfs + agentVersion)，
# 因此需要 Broker 的三个变量。只读取需要的键，不整份 source（避免把控制令牌等带进本进程）。
read_broker_env() {
    key="$1"
    if [ -f "$BROKER_ENV" ]; then
        value=$(grep -m1 "^${key}=" "$BROKER_ENV" | cut -d= -f2- || true)
        if [ -n "$value" ]; then
            export "$key=$value"
        fi
    fi
}
read_broker_env FIRECRACKER_KERNEL_PATH
read_broker_env FIRECRACKER_ROOTFS_PATH
read_broker_env HARNESS_GUEST_AGENT_VERSION

echo "[harness-maintenance] disk-check /data"
$BUN run scripts/harness-ops.ts disk-check --path /data --warn 80 --critical 90 || true
echo "[harness-maintenance] disk-check /"
$BUN run scripts/harness-ops.ts disk-check --path / --warn 80 --critical 90 || true
echo "[harness-maintenance] backup"
$BUN run scripts/harness-ops.ts backup --database "$DB" --backup-dir "$BACKUP_DIR" --keep 7
echo "[harness-maintenance] cleanup"
$BUN run scripts/harness-ops.ts cleanup --vm-runtime "$VM_RUNTIME" --snapshot-pool "$SNAPSHOT_POOL" --artifacts "$ARTIFACT_ROOT" --database "$DB" --max-age-hours 72 --max-snapshots 8 --apply
echo "[harness-maintenance] done"
