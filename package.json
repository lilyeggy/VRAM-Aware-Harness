{
  "name": "agent-harness",
  "module": "src/index.ts",
  "type": "module",
  "private": true,
  "scripts": {
    "test": "bun test ./tests",
    "typecheck": "tsc --noEmit",
    "verify:stage0": "bun run test && bun run typecheck && bun run demo:day7",
    "start": "bun run src/main.ts",
    "demo:day7": "bun run src/demo/day7-fake-demo.ts",
    "demo:console": "bun run src/demo/task-console-demo.ts",
    "smoke:http": "bun run scripts/day7-http-smoke.ts",
    "smoke:container": "bun run scripts/container-sandbox-smoke.ts",
    "smoke:container:attacks": "bun run scripts/container-sandbox-attack-smoke.ts",
    "benchmark:sandbox": "bun run scripts/sandbox-runtime-benchmark.ts",
    "preflight:server": "bash scripts/server-preflight.sh",
    "course:open": "cd docs/course && python3 -m http.server 8770",
    "basics:open": "python3 -m http.server 8789"
  },
  "devDependencies": {
    "@types/bun": "latest"
  },
  "peerDependencies": {
    "typescript": "^5"
  },
  "packageManager": "pnpm@11.1.3+sha512.c85357fe17ca12dd23dd7071822666dfd7e3cb76fe214e3370b5ea2fb34f2a231185509b63e717f3cd0acb38dd3f8d82bcd5e8172400ae678b70ea4fbed0896d",
  "dependencies": {
    "@earendil-works/pi-coding-agent": "0.80.10",
    "typebox": "1.3.6"
  }
}
