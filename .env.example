[TEMPLATE]
# Pi / vLLM
# model id 语义：优先 PI_MODEL_ID；未设置时回退 VLLM_MODEL_ID（兼容旧部署）。
# 外部模型服务也应显式设置 PI_MODEL_ID。
PI_MODEL_ID=qwen3.5-4b
#VLLM_MODEL_ID=qwen3.5-4b
VLLM_BASE_URL=http://127.0.0.1:8000/v1
PI_PROVIDER=local-vllm
PI_MODELS_PATH=.pi/spike/models.json
PI_TOOLS=read,bash,edit,write,grep,find,ls


# Harness process
# 有独立数据盘（如 /data）时建议指向 /data/harness/harness.sqlite；workspace/vm-runtime/snapshots 同理。
HARNESS_DATABASE_PATH=./data/harness.sqlite
HARNESS_HOST=127.0.0.1
HARNESS_PORT=3000
HARNESS_PUMP_INTERVAL_MS=1000

# ---- 账户注册策略（实验室接入收口）----
# open（默认，兼容旧部署）/ invite（必须携带邀请码）/ closed（关闭自助注册）。
# 交给实验室或他人使用前，建议显式设为 invite 或 closed。
#HARNESS_REGISTRATION_MODE=invite
#HARNESS_REGISTRATION_INVITE_CODE=change-me
# 单机运维：bun run scripts/harness-ops.ts disk-check|backup|restore|cleanup
# （备份 SQLite、按年龄/条目数清理 VM 运行目录与快照池；cleanup 默认 dry-run）。

# ---- HTTP 入口限流（单机内存固定窗口，默认开启）----
# 防止单个租户/单个 IP 刷爆入口；超限返回 429 + Retry-After。
# 健康检查 /health、/ready 不参与限流。
#HARNESS_RATE_LIMIT_ENABLED=true
#HARNESS_RATE_LIMIT_WINDOW_MS=60000
#HARNESS_RATE_LIMIT_MAX_PER_TENANT=600
# 每 IP 每窗口请求上限；默认 1200：实验室/办公室通常整层共用一个 NAT 出口 IP，
# 所有人的 UI 轮询都记在同一个 IP 桶上；租户配额由 HARNESS_RATE_LIMIT_MAX_PER_TENANT 负责。
#HARNESS_RATE_LIMIT_MAX_PER_IP=1200
# 仅当 Master 只监听 loopback、前面是可信 Caddy/Nginx 时才开启：
# 直接暴露时开启会让客户端伪造 X-Forwarded-For 绕过限流。
#HARNESS_TRUST_PROXY=false

# ---- F9：workspace 快照与 artifact 限额（防单 Run 打爆磁盘/内存）----
# 快照扫描超过文件数/深度即 fail-closed，拒绝生成不完整 Diff。
#HARNESS_WORKSPACE_SNAPSHOT_MAX_FILES=20000
#HARNESS_WORKSPACE_SNAPSHOT_MAX_DEPTH=32
# artifact 每 Run 超过文件数/总字节数即停止捕获并 warning。
#HARNESS_ARTIFACT_MAX_FILES_PER_RUN=200
#HARNESS_ARTIFACT_MAX_BYTES_PER_RUN=52428800

# production 时强制 HARNESS_USE_JAILER=true、HARNESS_SANDBOX_PROVIDER=microvm，
# 且必须设置 HARNESS_SANDBOX_BROKER_SOCKET；development 不启用这些强制项。
HARNESS_ENV=development

# Worker 隔离：process（同 UID 子进程，向后兼容）/ systemd（生产推荐：专用 UID + cgroup + 只读宿主）。
# systemd 模式需要 root 安装 scripts/harness-worker-run.sh 到 /usr/local/sbin，
# 并提供 /etc/harness/worker-launcher.conf；Master 通过 sudo -n 调用该窄 helper。
#HARNESS_WORKER_ISOLATION=systemd
#HARNESS_WORKER_SYSTEMD_LAUNCHER_PATH=/usr/local/sbin/harness-worker-run
#HARNESS_WORKER_SYSTEMD_SUDO_PATH=/usr/bin/sudo
# systemd worker 专用凭据/模型缓存（通常属 harness-worker UID，Master 不可读）。
#HARNESS_WORKER_PI_AUTH_PATH=/var/lib/harness-worker/auth.json
#HARNESS_WORKER_PI_MODELS_PATH=/var/lib/harness-worker/models.json
# Worker Landlock 文件系统约束（Linux）：off（默认）/ on（尽力启用）/ required（失败即退出 78）。
# systemd launcher 生产配置会传 required；process 模式可在 Master 环境显式打开。
#HARNESS_WORKER_LANDLOCK=required
# 额外可写目录（逗号分隔）；默认已含 /tmp、$HOME、/run/harness，并自动放行 /dev/null 等设备文件。
#HARNESS_WORKER_LANDLOCK_WRITABLE_PATHS=/var/lib/harness-worker
# 控制面 egress ACL（§9.7 v1.3 第 3 项）：Broker/Master 由 systemd 单元
# IPAddressDeny/IPAddressAllow 限制；Worker 的放行清单在
# /etc/harness/worker-launcher.conf 的 WORKER_EGRESS_ALLOW（默认仅 loopback）。

# Sandbox: managed-local is development/test only. Container defaults to gVisor/runsc.
HARNESS_SANDBOX_PROVIDER=managed-local
HARNESS_SANDBOX_PROFILE=development
HARNESS_SANDBOX_RUNTIME=runc
HARNESS_CONTAINER_IMAGE=alpine:3.20
HARNESS_CONTAINER_USER_ID=65532
# N14: docker --pids-limit. gVisor(runsc) kills the WHOLE sandbox when this is
# hit, while runc only fails the fork, so keep it below gVisor's internal cap.
HARNESS_CONTAINER_PIDS_LIMIT=128

# Scheduling（租户公平调度；模型服务在平台外，资源压力固定 NORMAL）
HARNESS_MAX_ACTIVE_RUNS=2
HARNESS_MAX_ACTIVE_RUNS_PER_TENANT=1
# N10: a queued Run whose head has waited longer than this jumps the tenant
# rotation (0 = off, pure round-robin).
HARNESS_SCHEDULER_AGING_MS=60000
# §9.8 v1.4 Phase 2：队列深度 backpressure（0 = 不启用）。超限时
# POST /runs 返回 429 + Retry-After，不创建 Run。
HARNESS_MAX_QUEUED_RUNS=0
HARNESS_MAX_QUEUED_RUNS_PER_TENANT=0
# §9.8 v1.4 Phase 2：RunAttempt 租约/心跳。心跳必须小于 TTL；进程崩溃后
# 超过 TTL 的 RUNNING Attempt 会被回收为 INTERRUPTED，可经 Checkpoint 恢复。
HARNESS_RUN_LEASE_TTL_MS=60000
HARNESS_RUN_LEASE_HEARTBEAT_MS=10000
# 可选：多实例时区分租约 owner；缺省 harness-<pid>。
#HARNESS_INSTANCE_ID=harness-1
# §9.8 v1.4 Phase 3：可重试失败的重试策略（无任何 PREPARED 工具副作用时才
# 自动退避重试；有副作用证据的失败保持 INTERRUPTED 交给恢复/人工复核）。
HARNESS_RUN_MAX_ATTEMPTS=3
HARNESS_RUN_RETRY_BASE_MS=1000
HARNESS_RUN_RETRY_MAX_MS=30000

# 方向 C：LLM 网关后端（JSON 数组，按优先级有序；缺省/空=网关不启用）。
# 请求 POST /v1/chat/completions 按 model(逻辑名) 路由，主失败自动回退下一个后端。
# LLM_BACKENDS=[{"id":"vllm-local","baseUrl":"http://127.0.0.1:8000/v1","model":"qwen3.5-4b","logicalModel":"qwen3.5-4b"},{"id":"cloud-backup","baseUrl":"https://cloud/v1","apiKey":"sk-...","model":"fallback-model","logicalModel":"qwen3.5-4b"}]

# ── N28 会话压缩：两层机制，顺序不可颠倒 ─────────────────────────────────
# 主机制（Pi 侧摘要式压缩）：Pi 在会话内按真实 token 用量触发，把早期历史交给
# 模型摘要后落盘，后续请求只带「摘要 + 近期历史」。注意上游默认
# reserveTokens=16384 / keepRecentTokens=20000 是给大窗口调的：在 32768 窗口下
# 触发点(16384)比它被要求保留的(20000)还小，切点会一路退到会话开头，导致没有
# 可摘要内容、压缩静默不执行（8h 长稳中 87 个 Pi 会话仅 7 个产生过压缩记录）。
# 因此必须显式下发，且满足两条不变量：
#   触发点 = 模型窗口 − PI_COMPACTION_RESERVE_TOKENS；
#   RESERVE 必须 > KEEP_RECENT，也必须 > 单次输出上限（否则触发时已无输出空间）。
# 本部署窗口 32768、输出上限 4096 → 取 12288 / 8192
# （触发点 20480，压缩后保留约 8192，为输出留出 12288）。
PI_COMPACTION_ENABLED=true
PI_COMPACTION_RESERVE_TOKENS=12288
PI_COMPACTION_KEEP_RECENT_TOKENS=8192

# 兜底机制（网关侧截断）：Pi 压缩未生效或参数被误配时，网关在转发前按「轮次
# 边界」丢弃最老的对话历史，并插入一条显式说明（不静默）。不开的话，会话累积
# 超过模型窗口后每个请求都会被上游 400 拒绝且永不恢复（8h 长稳实测 21.3% 的
# 任务因此失败）。取值必须【大于】Pi 的触发点，否则网关会先砍掉 Pi 本可以摘要
# 的信息；它只在 Pi 失效时出手。设为 0 可关闭（回到旧行为）。
LLM_CONTEXT_BUDGET_TOKENS=24000

# ---- Sandbox Broker（方案 B：非特权 Master/Worker → 特权最小 Broker）----
# 设置后 Master/Worker 不再直接持有 Firecracker 驱动，只通过 Unix socket 向
# Broker 发送 create/execute/terminate；Broker 进程需可访问 /dev/kvm 与
# Firecracker 资产，Master/Worker 可运行在非特权、受限环境。
# 生产建议与 jailer 搭配；非 jailer 时快照仍 fail-closed。
#HARNESS_SANDBOX_BROKER_SOCKET=/run/harness/sandbox-broker.sock
# Master -> Broker 的 control token（生产必填）：Broker 用它拒绝 Worker/其它同组
# 进程发起的 create；Worker 不持有该值，只能 execute/terminate 自己 sandbox 的 token。
#HARNESS_SANDBOX_BROKER_CONTROL_TOKEN=change-me
# SO_PEERCRED 校验（Linux）：Broker 用对端进程 UID 做第二道门。设置后，
# 连接白名单之外或读不到凭据的连接在握手前被拒绝；生产环境必须至少配置一项。
#HARNESS_SANDBOX_BROKER_PEER_UIDS=1000,998
#HARNESS_SANDBOX_BROKER_MASTER_UID=1000
#HARNESS_SANDBOX_BROKER_WORKER_UID=998

# ---- Firecracker MicroVM（strict profile / 硬件隔离）----
# P0 修复后，microvm strict 链路全部 fail-closed：三项均为必需，缺一即拒绝创建。
# Guest 内核镜像（如 vmlinux / vmlinux-6.1-microvm）
#FIRECRACKER_KERNEL_PATH=
# rootfs 模板镜像（ext4）：每 Run 复制一份独立副本
#FIRECRACKER_ROOTFS_PATH=
# 工作区磁盘模板（ext4）：每 Run 复制一份挂载为 VM 第二块盘。
# 没有它，VM 内文件操作不落用户工作区、也没有跨 Run 工作区隔离。
#FIRECRACKER_WORKSPACE_DISK_TEMPLATE_PATH=
# 注意：本部署不提供网卡服务——VM 内没有网络设备，allowNetwork=true 一律被拒绝。

# ---- MicroVM Phase 3：快照加速 ----
# 快照加速：首次完整开机后制作黄金快照，后续同模板 VM 走 snapshot/load（默认关）。
# 【无需自建 Firecracker】官方 release 二进制已编译 pause/resume，真机实测可用
# （此前"必须 cargo build --features snapshot"的结论基于错误探测信号，已推翻）。
# 暂停/恢复的唯一官方途径是 `PATCH /vm {"state":"Paused"|"Resumed"}`；
# 官方从未提供 `InstancePause`/`InstanceResume` 动作，用它探测必然假阴性。
# 启用前用 scripts/microvm/preflight-microvm.sh 校验二进制含 VcpuResponse::Paused。
# 注意：快照加速必须搭配 jailer。非 jailer 模式下 Firecracker 会把黄金 VM 的宿主
# 绝对磁盘路径固化进 vm.snap，多台恢复 VM 将共享同一工作区磁盘（跨租户串写）。
# 驱动已对该组合 fail-closed：非 jailer 启用快照会直接拒绝启动。
#HARNESS_VM_SNAPSHOTS_ENABLED=true
#HARNESS_VM_SNAPSHOT_POOL_DIR=/var/lib/harness/snapshots
# ---- 共享只读基础文件（启动路径优化，默认开启）----
# 内核、rootfs、快照文件（vm.snap/mem.snap）不再逐 VM 拷进 jail chroot，而是
# 硬链接共享同一 inode：恢复路径省掉 512MB 内存镜像拷贝（真机实测 ~298ms）。
# 依据 Firecracker 官方 snapshot-support.md：加载快照时内存文件做 MAP_PRIVATE
# 只读映射 + 按需分页，写入走 COW 匿名内存，官方明确允许"多台 microVM 共享
# 内存页与只读盘"；前提是该文件对 Firecracker 与宿主都不可变。
# 因此驱动做了两件事：① 共享进来的文件一律 chmod 0444；② 池内快照发布走
# staging 目录 + rename，绝不原地截断正在被映射的文件。
# 硬链接失败（跨设备/无权限）会自动退化为复制，行为与旧路径一致。
# rootfs 共享时以 is_read_only: true 挂给 guest（同一 inode 不能被多台 VM 写）。
# 默认开启（设 0 关闭，回退到逐 VM 复制）。内核/rootfs 与 VM 运行时根目录不在
# 同一文件系统时硬链接会退化为复制（跨设备 EXDEV），收益只剩快照文件这部分。
# 想连 rootfs 的复制也省掉，就把模板放到 VM 运行时根目录所在的文件系统上。
#HARNESS_VM_SHARE_BASE_FILES=0
# rootfs 共享默认**关闭**。开启后 rootfs 以只读 virtio 盘挂给 guest（共享 inode
# 不能被多台 VM 写），guest 内除 /workspace 外全部只读：`pip install`、编译缓存、
# 写 /tmp 或 $HOME 的工具会 EROFS 失败。收益是热恢复 ~200ms → ~100ms。
# 真机已验证可启动并执行命令；要让 guest 重新可写需在 guest init 里挂 tmpfs 可写层。
#HARNESS_VM_SHARE_ROOTFS=1
# 分阶段耗时追踪：每台 VM 往 stderr 打 `[vm-phase] <id> <阶段> <ms>`（默认关）。
#HARNESS_VM_PHASE_TRACE=1
# 内核启动日志：默认 quiet loglevel=3（串口只留必需输出）。排障时可设为 1 打开完整
# 内核启动日志，驱动会把它抓进 serialTail，并据此算 `serial-first-line` 埋点
# （真机实测"第一个串口字节"在冷启动 15ms 就出现，所以冷启动的 1.28s 不在内核，
# 而在 guest 用户态：busybox init 链 + socat + agent 二进制加载）。
#HARNESS_VM_BOOT_VERBOSE=1
# 黄金快照预热：scripts/vm-snapshot-prewarm.ts（幂等，已存在则 VM_PREWARM_SKIP）。
# 放在服务启动时跑，用户遇到的第一个 Run 就不必付"冷启动 + 建快照"的 ~2.2s
# （生产实测：预热后首个 Run SANDBOX_ACQUIRED {durationMs: 166, warmHit: true}）。
# 部署示例见 deploy/harness-vm-prewarm.service.example 与 .timer.example（OnBootSec=20s）。
# guest agent 版本：参与快照模板指纹。改动 guest/agent 后必须同步提升，
# 否则模板指纹不变，会静默复用内含旧 agent 的黄金快照（guest 里跑的仍是旧代码）。
# ---- §9.7 v1.3 第 5 项：租户成本账单 ----
# GET /billing 需要 billing:read scope；默认只汇总 Provider 上报的模型成本
# （MODEL_COMPLETED.usage.cost.total），不凭空定价。平台可配置下列单价叠加
# token/沙箱秒/工具调用费用；非法或负值回退 0。
#HARNESS_BILLING_CURRENCY=USD
#HARNESS_BILLING_MODEL_INPUT_PER_MTOK=0
#HARNESS_BILLING_MODEL_OUTPUT_PER_MTOK=0
#HARNESS_BILLING_SANDBOX_SECOND=0
#HARNESS_BILLING_TOOL_CALL=0

# ---- §9.8 v1.4 Phase 4：MCP 工具接入 ----
# JSON 数组；每项 { name, command, args?, env?, cwd?, requestTimeoutMs? }。
# Master 启动时连接这些 stdio MCP server，并把它们的工具以
# mcp__<server>__<tool> 名称暴露给 Agent；工具调用仍经过 ToolGateway
# 的策略守卫、PREED 记账与审计，只读工具按 READ_ONLY 分类。
# 生产（systemd worker）下，MCP server 由 Worker 进程拉起，继承 Worker 的
# seccomp / Landlock / egress ACL：不能联网，也不能写 WORKER_RW_PATHS 之外。
#HARNESS_MCP_SERVERS=[{"name":"fs","command":"npx","args":["-y","@modelcontextprotocol/server-filesystem","/data"]}]
