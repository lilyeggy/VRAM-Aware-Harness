# Pi / vLLM
VLLM_MODEL_ID=qwen3.5-4b
VLLM_BASE_URL=http://127.0.0.1:8000/v1
PI_PROVIDER=local-vllm
PI_MODELS_PATH=.pi/spike/models.json
PI_TOOLS=read,bash,edit,write,grep,find,ls

# Harness process
HARNESS_DATABASE_PATH=./data/harness.sqlite
HARNESS_HOST=127.0.0.1
HARNESS_PORT=3000
HARNESS_PUMP_INTERVAL_MS=1000

# Sandbox: managed-local is development/test only. Container defaults to gVisor/runsc.
HARNESS_SANDBOX_PROVIDER=managed-local
HARNESS_SANDBOX_PROFILE=development
HARNESS_SANDBOX_RUNTIME=runc
HARNESS_CONTAINER_IMAGE=alpine:3.20
HARNESS_CONTAINER_USER_ID=65532

# Scheduling and resource observation
HARNESS_MAX_ACTIVE_RUNS=2
HARNESS_MAX_ACTIVE_RUNS_PER_TENANT=1
HARNESS_GPU_IDS=0
HARNESS_RESOURCE_TIMEOUT_MS=3000

# 方向 C：LLM 网关后端（JSON 数组，按优先级有序；缺省/空=网关不启用）。
# 请求 POST /v1/chat/completions 按 model(逻辑名) 路由，主失败自动回退下一个后端。
# LLM_BACKENDS=[{"id":"vllm-local","baseUrl":"http://127.0.0.1:8000/v1","model":"qwen3.5-4b","logicalModel":"qwen3.5-4b"},{"id":"cloud-backup","baseUrl":"https://cloud/v1","apiKey":"sk-...","model":"fallback-model","logicalModel":"qwen3.5-4b"}]

# N28: 会话上下文预算（token）。> 0 时网关在转发前按「轮次边界」丢弃最老的
# 对话历史，并插入一条显式说明（不静默）。不开的话，会话累积超过模型窗口后
# 每个请求都会被上游 400 拒绝且永不恢复（8h 长稳实测 21.3% 的任务因此失败）。
# 取值应设在「模型上下文窗口 − 预留输出」以内；本部署窗口 32768、预留 4096。
# 设为 0 可关闭压缩（回到旧行为）。
LLM_CONTEXT_BUDGET_TOKENS=24000
