# Isolated Qwen3.8 vLLM service. Keep it loopback-only on the GPU host.
VLLM_MODEL_ID=qwen3.8-27b-fp8
VLLM_BASE_URL=http://127.0.0.1:18000/v1
VLLM_METRICS_URL=http://127.0.0.1:18000/metrics
PI_PROVIDER=local-vllm
PI_MODELS_PATH=/home/cxr/harness-qwen38-live-20260904/.pi/spike/models.json

# Dedicated Harness state; do not share the older DeepSeek deployment's data.
HARNESS_DATABASE_PATH=/home/cxr/harness-qwen38-live-20260904/runtime/harness.sqlite
HARNESS_WORKSPACE_ROOT=/home/cxr/harness-qwen38-live-20260904/runtime/workspaces
HARNESS_HOST=127.0.0.1
HARNESS_PORT=13000
HARNESS_PUMP_INTERVAL_MS=1000

# The target host has runc but not gVisor/runsc. This is explicitly development only.
HARNESS_SANDBOX_PROVIDER=managed-local
HARNESS_SANDBOX_PROFILE=development
HARNESS_SANDBOX_RUNTIME=runc

# Pillar 2: keep the GPUs busy while tools/filesystem I/O run concurrently in
# sandboxes. Concurrency slots count agent runs, not tool calls.
HARNESS_MAX_ACTIVE_RUNS=30
HARNESS_MAX_ACTIVE_RUNS_PER_TENANT=10
# Pillar 3: queued runs waiting longer than this are safely failed with
# QUEUE_TIMEOUT instead of starving forever.
HARNESS_QUEUE_TTL_MS=300000
HARNESS_GPU_IDS=0,1
HARNESS_RESOURCE_TIMEOUT_MS=3000

# Pillar 2: route model inference through the LLM gateway to both local vLLM
# instances (GPU 0 / GPU 1). VLLM_BASE_URLS expands to vllm-gpu0 / vllm-gpu1;
# explicit LLM_BACKENDS (JSON array) takes precedence when set.
VLLM_BASE_URLS=http://127.0.0.1:18000/v1,http://127.0.0.1:18001/v1
LLM_GATEWAY_STRATEGY=round-robin
LLM_HEALTH_PROBE_INTERVAL_MS=10000
LLM_PREFIX_CACHE=1
# Pillar 2: streaming requests get stream_options.include_usage injected and
# the trailing SSE usage chunk is scanned into the cache metrics ledger.
# Set to 0 only if a backend rejects the stream_options field.
LLM_STREAM_USAGE_CAPTURE=1

# ── N28 会话压缩：两层机制，顺序不可颠倒 ─────────────────────────────────
# 主机制（Pi 侧摘要式压缩）：Pi 在会话内按真实 token 用量触发，把早期历史交给
# 模型摘要后落盘，后续请求只带「摘要 + 近期历史」。注意上游默认
# reserveTokens=16384 / keepRecentTokens=20000 是给大窗口调的：在 32768 窗口下
# 触发点(16384)比它被要求保留的(20000)还小，切点会一路退到会话开头，导致没有
# 可摘要内容、压缩静默不执行（8h 长稳中 87 个 Pi 会话仅 7 个产生过压缩记录）。
# 因此必须显式下发，且满足两条不变量：
#   触发点 = 模型窗口 − PI_COMPACTION_RESERVE_TOKENS；
#   RESERVE 必须 > KEEP_RECENT，也必须 > 单次输出上限（否则触发时已无输出空间）。
# 本部署窗口 32768、输出上限 4096 → 取 12288 / 8192
# （触发点 20480，压缩后保留约 8192，为输出留出 12288）。
PI_COMPACTION_ENABLED=true
PI_COMPACTION_RESERVE_TOKENS=12288
PI_COMPACTION_KEEP_RECENT_TOKENS=8192

# 兜底机制（网关侧截断）：Pi 压缩未生效或参数被误配时，网关在转发前按「轮次
# 边界」丢弃最老的对话历史，并插入一条显式说明（不静默）。不开的话，会话累积
# 超过模型窗口后每个请求都会被上游 400 拒绝且永不恢复（8h 长稳实测 21.3% 的
# 任务因此失败）。取值必须【大于】Pi 的触发点，否则网关会先砍掉 Pi 本可以摘要
# 的信息；它只在 Pi 失效时出手。设为 0 可关闭（回到旧行为）。
LLM_CONTEXT_BUDGET_TOKENS=24000

# Pi/Worker reaches the model ONLY through the gateway using this dedicated
# key (scope: models:generate — least privilege, revocable independently of
# the bootstrap key). Put the same value into .pi models.json providers'
# "apiKey" (see deploy/qwen38-vllm-models.json, baseUrl now points at the
# gateway port 13000, not vLLM directly).
HARNESS_AGENT_API_KEY=change-me-to-a-long-random-value
