# 单机 systemd 部署示例：Master（非 root）。
# 完整步骤见 docs/deployment-single-node-systemd.zh-CN.md。
[Unit]
Description=Harness Master (non-root)
Requires=harness-broker.service
After=harness-broker.service network-online.target
Wants=network-online.target

[Service]
Type=simple
User=harness
Group=harness
SupplementaryGroups=harness-worker
WorkingDirectory=/srv/VRAM-Aware-Harness
EnvironmentFile=/etc/harness/master.env
ExecStart=/usr/local/bin/bun run src/main.ts
Restart=on-failure
RestartSec=3
NoNewPrivileges=true
PrivateTmp=true
# 控制面 egress ACL（§9.7 v1.3 第 3 项）：Master 只监听/访问 loopback；
# 如需从局域网访问 API，把入口地址加入 IPAddressAllow。
IPAddressDeny=any
IPAddressAllow=127.0.0.0/8

[Install]
WantedBy=multi-user.target
