# A6000 (100.65.162.35, f630) 部署配置 —— 2026-09-10
# 模型：Qwen2.5-7B-Instruct（vLLM 0.7.3，conda env harness-vllm）
# 权重：/home/f630/homePLUS/harness-models/cache（数据盘，cxr/harness-deploy/models 软链）

VLLM_MODEL_ID=qwen2.5-7b-instruct
VLLM_BASE_URL=http://127.0.0.1:18000/v1
VLLM_METRICS_URL=http://127.0.0.1:18000/metrics
PI_PROVIDER=local-vllm
PI_MODELS_PATH=/home/f630/cxr/harness-deploy/.pi/spike/models.json

HARNESS_DATABASE_PATH=/home/f630/cxr/harness-deploy/runtime/harness.sqlite
HARNESS_WORKSPACE_ROOT=/home/f630/cxr/harness-deploy/runtime/workspaces
HARNESS_HOST=127.0.0.1
HARNESS_PORT=13000
HARNESS_PUMP_INTERVAL_MS=1000

# A6000 无 runsc：managed-local + development（与示例一致，诚实标注）
HARNESS_SANDBOX_PROVIDER=managed-local
HARNESS_SANDBOX_PROFILE=development
HARNESS_SANDBOX_RUNTIME=runc

HARNESS_MAX_ACTIVE_RUNS=30
HARNESS_MAX_ACTIVE_RUNS_PER_TENANT=10
HARNESS_QUEUE_TTL_MS=300000
# N10：队列老化——队首等待超过 60s 的 Run 插队优先调度。
HARNESS_SCHEDULER_AGING_MS=60000
# N5：同机 vLLM 稳态预占约 90% 显存，准入按基线之上的增量判定。
# （历史做法是把 BUSY/CRITICAL 阈值手工校准到 93/98，那等于把这个部署的
#   特殊性写死进阈值；基线语义才可解释、也不会污染其他部署。）
HARNESS_GPU_MEMORY_BASELINE_PERCENT=90
HARNESS_GPU_IDS=0
HARNESS_RESOURCE_TIMEOUT_MS=3000

# 网关：单后端直连本地 vLLM
VLLM_BASE_URLS=http://127.0.0.1:18000/v1
LLM_GATEWAY_STRATEGY=round-robin
LLM_HEALTH_PROBE_INTERVAL_MS=10000
LLM_PREFIX_CACHE=1
LLM_STREAM_USAGE_CAPTURE=1

# 网关专用凭证（启动后用 bootstrap key 创建，填入此处与 models.json）
HARNESS_AGENT_API_KEY=change-me-to-a-long-random-value
